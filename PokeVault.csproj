<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PokeVault</AssemblyName>
    <Product>PokeVault</Product>
    <Version>1.2.0</Version>
    <ApplicationIcon Condition="Exists('pokevault.ico')">pokevault.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- data\ is your vault (only used when running from source). Never build or publish it. -->
  <!-- the installer is its own project (installer\), and dist\ is its output -->
  <ItemGroup>
    <Compile Remove="installer\**;dist\**" />
    <Content Remove="installer\**;dist\**" />
    <None Remove="installer\**;dist\**" />
    <EmbeddedResource Remove="installer\**;dist\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
    <Compile Remove="data\**" />
    <EmbeddedResource Remove="data\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="PKHeX.Core" Version="26.10.18" />
  </ItemGroup>

</Project>
